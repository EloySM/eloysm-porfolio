---
const { t, links } = Astro.props;
---

<section id="contact" class="w-full lg:w-5xl mx-auto mt-22 py-12">
  <div class="rounded-3xl border border-white/10 bg-white/5 p-8 sm:p-10">
    <p class="text-sm uppercase tracking-wider text-white/60">
      {t.contact.eyebrow}
    </p>
    <h2
      class="mt-2 text-3xl sm:text-4xl font-bold text-white"
      style="font-family: var(--font-cal-sans);"
    >
      {t.contact.title}
    </h2>

    <p class="mt-4 text-white/70 max-w-2xl">{t.contact.intro}</p>

    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-4">
        <a
          href={`https://mail.google.com/mail/?view=cm&fs=1&to=${links.email}`} target="_blank" rel="noopener"
          class="flex items-center justify-between rounded-2xl border border-white/10 bg-black/20 px-5 py-4 text-white/80 hover:text-white hover:bg-white/10 transition"
        >
          <div>
            <p class="text-sm text-white/60">{t.contact.cards.emailLabel}</p>
            <p class="font-medium">{t.contact.cards.emailValue}</p>
          </div>
          <span aria-hidden="true">→</span>
        </a>

        <a
          href={links.linkedin}
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between rounded-2xl border border-white/10 bg-black/20 px-5 py-4 text-white/80 hover:text-white hover:bg-white/10 transition"
        >
          <div>
            <p class="text-sm text-white/60">{t.contact.cards.linkedinLabel}</p>
            <p class="font-medium">{t.contact.cards.linkedinValue}</p>
          </div>
          <span aria-hidden="true">→</span>
        </a>

        <a
          href={links.github}
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between rounded-2xl border border-white/10 bg-black/20 px-5 py-4 text-white/80 hover:text-white hover:bg-white/10 transition"
        >
          <div>
            <p class="text-sm text-white/60">{t.contact.cards.githubLabel}</p>
            <p class="font-medium">{t.contact.cards.githubValue}</p>
          </div>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <form
        id="contact-form"
        class="rounded-2xl border border-white/10 bg-black/20 p-5 space-y-4"
      >
        <!-- Honeypot invisible -->
        <input
          class="hidden"
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
        />

        <div>
          <label for="name" class="text-sm text-white/70"
            >{t.contact.form.name}</label
          >
          <input
            id="name"
            name="name"
            required
            class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-white placeholder:text-white/30 focus:outline-none focus:ring-1 focus:ring-white/30"
            placeholder={t.contact.form.namePlaceholder}
          />
        </div>

        <div>
          <label for="email" class="text-sm text-white/70"
            >{t.contact.form.email}</label
          >
          <input
            id="email"
            type="email"
            name="email"
            required
            class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-white placeholder:text-white/30 focus:outline-none focus:ring-1 focus:ring-white/30"
            placeholder={t.contact.form.emailPlaceholder}
          />
        </div>

        <div>
          <label for="message" class="text-sm text-white/70"
            >{t.contact.form.message}</label
          >
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-white placeholder:text-white/30 focus:outline-none focus:ring-1 focus:ring-white/30"
            placeholder={t.contact.form.messagePlaceholder}></textarea>
        </div>

        <button
          id="contact-submit"
          type="submit"
          class="w-full rounded-xl bg-white px-4 py-3 text-sm font-semibold text-black hover:opacity-90 transition"
        >
          {t.contact.form.submit}
        </button>

        <p id="contact-status" class="text-xs text-white/60"></p>
      </form>
    </div>
  </div>
</section>
