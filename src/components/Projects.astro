---
import { ui, type Locale } from "../i18n/ui";

type T = (typeof ui)[Locale];
type Links = { linkedin: string; github: string; email: string };

const { t, links } = Astro.props as { t: T; links: Links };
---

<section id="projects" class="w-full max-w-5xl mx-auto px-6 py-24">
  <div class="flex items-end justify-between gap-6">
    <div>
      <p class="text-sm uppercase tracking-wider text-white/60">
        {t.projects.eyebrow}
      </p>
      <h2
        class="text-3xl sm:text-4xl font-bold text-white"
        style="font-family: var(--font-cal-sans);"
      >
        {t.projects.title}
      </h2>
      <p class="mt-3 text-white/70 max-w-2xl">{t.projects.intro}</p>
    </div>

    <a
      href={links.github}
      target="_blank"
      rel="noopener"
      class="hidden sm:inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/80 hover:text-white hover:bg-white/10 transition"
    >
      {t.projects.ctaGithub}
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Project card -->
    <article
      class="group rounded-2xl border border-white/10 bg-white/5 p-6 transition hover:bg-white/10 flex flex-col min-h-65"
    >
      <div class="flex items-start justify-between gap-4">
        <h3 class="text-lg font-semibold text-white">
          {t.projects.card1.title}
        </h3>
        <span
          class="rounded-full border border-white/10 bg-black/30 px-3 py-1 text-xs text-white/70"
        >
          {t.projects.card1.type}
        </span>
      </div>

      <img
        src="/spency.webp"
        alt={t.projects.card1.title}
        loading="lazy"
        class="mt-4 w-full rounded-xl"
      />

      <p class="mt-4 text-white/70">{t.projects.card1.desc}</p>

      <!-- Tags + buttons pinned to bottom -->
      <div class="mt-auto">
        <div class="mt-10 mb-10 flex flex-wrap justify-end gap-2">
          {
            t.projects.card1.tags.map((tag: string) => (
              <span class="rounded-full bg-white/10 px-3 py-1 text-xs text-white/70">
                {tag}
              </span>
            ))
          }
        </div>

        <div class="mt-4 flex items-center gap-3">
          <a
            href="#"
            class="inline-flex items-center justify-center rounded-full bg-white text-black px-4 py-2 text-sm font-medium hover:opacity-90 transition"
          >
            {t.projects.card1.live}
          </a>
          <a
            href="#"
            class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/80 hover:text-white hover:bg-white/10 transition"
          >
            {t.projects.card1.code}
          </a>
        </div>
      </div>
    </article>

    <!-- Placeholder Card (Future project) -->
    <article
      class="group rounded-2xl border border-white/10 bg-white/5 p-6 transition hover:bg-white/10 flex flex-col min-h-65"
    >
      <div class="flex items-start justify-between gap-4">
        <h3 class="text-lg font-semibold text-white/70">In the future</h3>
        <span
          class="rounded-full border border-white/10 bg-black/20 px-3 py-1 text-xs text-white/60"
        >
          Soon
        </span>
      </div>

      <p class="mt-3 text-white/50">New project coming soon.</p>

      <!-- Tags + buttons pinned to bottom -->
      <div class="mt-auto">
        <div class="mt-10 mb-10 flex flex-wrap justify-end gap-2">
          <span class="rounded-full bg-white/5 px-3 py-1 text-xs text-white/50"
            >—</span
          >
          <span class="rounded-full bg-white/5 px-3 py-1 text-xs text-white/50"
            >—</span
          >
          <span class="rounded-full bg-white/5 px-3 py-1 text-xs text-white/50"
            >—</span
          >
        </div>

        <div class="mt-4 flex items-center gap-3">
          <span
            class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/40"
          >
            Live
          </span>
          <span
            class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/40"
          >
            Code
          </span>
        </div>
      </div>
    </article>
  </div>
</section>
