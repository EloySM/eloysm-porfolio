---
import Header from "../components/Header.astro";
import { Font } from "astro:assets";
import "../styles/global.css";
---

<Font cssVariable="--font-onest" preload />
<Font cssVariable="--font-cal-sans" preload />

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="favicon" href="/favicon.svg" />
    <link rel="icon" type="image/svg" sizes="32x32" href="/favicon.svg" />
    <link rel="icon" type="image/svg" sizes="16x16" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Eloy's Portfolio - Web Developer and Programmer</title>
    <meta
      name="description"
      content="Hire Eloy to create a web aplication. Web Developer"
    />
    <meta property="og:title" content="Eloy Sánchez — Portfolio" />
    <meta property="og:description" content="Web Developer portfolio." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://eloysm.dev/" />
    <meta property="og:image" content="https://eloysm.dev/og-image.png" />
    <script is:inline>
      (function () {
        const forced = new URLSearchParams(location.search).get("lang");

        if (forced === "es") {
          localStorage.removeItem("locale");
          return location.replace("/es/" + (location.hash || ""));
        }
        if (forced === "en") {
          localStorage.removeItem("locale");
          return location.replace("/" + (location.hash || ""));
        }

        try {
          const saved = localStorage.getItem("locale");
          if (saved) return;
        } catch {}

        const path = window.location.pathname;
        if (path.startsWith("/es")) return;

        const langs =
          navigator.languages && navigator.languages.length
            ? navigator.languages
            : [navigator.language];

        const wantsEs = langs.some((l) =>
          (l || "").toLowerCase().startsWith("es"),
        );

        if (wantsEs) {
          try {
            localStorage.setItem("locale", "es");
          } catch {}
          window.location.replace("/es/" + (window.location.hash || ""));
        } else {
          try {
            localStorage.setItem("locale", "en");
          } catch {}
        }
      })();
    </script>
  </head>

  <body>
    <div
      class="fixed inset-0 top-0 z-[-2] bg-neutral-950 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <Header />
    <slot />
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-onest);
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    /* justify-content: center; */
    background-color: #151515;
    min-height: 100vh;

    ::selection {
      background-color: rgba(222, 55, 105, 0.9);
    }
  }
</style>
