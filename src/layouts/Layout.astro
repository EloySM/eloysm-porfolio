<style>
	:root {
		color-scheme: light dark;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: var(--font-onest);
	}

	body {
		display: flex;
		flex-direction: column;
		/* justify-content: center; */
		background-color: #151515;
		min-height: 100vh;
	}

</style>
