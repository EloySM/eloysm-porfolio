---
import Header from '../components/Header.astro';
import { Font } from "astro:assets";
import '../styles/global.css';
---

<Font cssVariable="--font-onest" preload />
<Font cssVariable="--font-cal-sans" preload />

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Eloy's Portfolio - Web Developer and Programmer</title>
		<meta name="description" content="Hire Eloy to create a web aplication. Web Developer" />
		<script is:inline>
		  (function () {
		    // Si ya eligió idioma antes, no redirigimos
		    try {
		      const saved = localStorage.getItem("locale");
		      if (saved) return;
		    } catch {}
			
		    // Si ya estás en /es/, no hagas nada
		    const path = window.location.pathname;
		    if (path.startsWith("/es")) return;
			
		    // Detecta idioma del navegador
		    const lang = (navigator.language || "").toLowerCase(); // ej: "es-es"
		    if (lang.startsWith("es")) {
		      try { localStorage.setItem("locale", "es"); } catch {}
		      // Mantén hash (#projects) si existe
		      const hash = window.location.hash || "";
		      window.location.replace("/es/" + hash);
		    } else {
		      try { localStorage.setItem("locale", "en"); } catch {}
		    }
		  })();
		</script>
	</head>

	<body>
		<div class="fixed inset-0 top-0 z-[-2] bg-neutral-950 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
		<Header />
		<slot/>
	</body>
</html>
